---
import { ArrowRight } from "@lucide/astro";
import BrandIcon from "./BrandIcon.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  viewHref: string;
  githubHref: string;
  visual: "platform" | "network" | "image";
  image?: string;
  imageAlt?: string;
  badge?: string;
}

const { title, description, tags, viewHref, githubHref, visual, image, imageAlt, badge } = Astro.props;

const hasViewLink = Boolean(viewHref && viewHref !== "#");
const hasGithubLink = Boolean(githubHref && githubHref !== "#");
const hasActions = hasViewLink || hasGithubLink;
---

<article class="glass-card group flex min-h-full flex-col overflow-hidden rounded-xl transition duration-200 hover:-translate-y-1 hover:border-accent/55">
  <div class="relative aspect-[16/10] overflow-hidden border-b border-white/10 bg-slate-950">
    {visual === "image" && image ? (
      <img src={image} alt={imageAlt ?? ""} class="size-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
    ) : (
      <div class:list={["abstract-thumb", visual === "network" ? "abstract-network" : "abstract-platform"]} aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
    )}
    {badge && (
      <span class="absolute left-4 top-4 rounded-md border border-emerald-300/50 bg-emerald-400/15 px-3 py-1 text-xs font-extrabold text-emerald-200">
        {badge}
      </span>
    )}
  </div>

  <div class="flex grow flex-col p-5">
    <h3 class="text-xl font-extrabold text-white">{title}</h3>
    <p class="mt-3 text-sm leading-7 text-slate-300">{description}</p>

    <div class="mt-5 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-md border border-white/10 bg-white/[0.04] px-2.5 py-1 text-xs font-semibold text-slate-300">{tag}</span>
      ))}
    </div>

    {hasActions && (
      <div class="mt-auto flex items-center justify-between gap-3 pt-6">
        {hasViewLink && (
          <a class="inline-flex items-center gap-1.5 text-sm font-extrabold text-accent transition hover:text-sky-200" href={viewHref}>
            View Project <ArrowRight size={16} aria-hidden="true" />
          </a>
        )}
        {hasGithubLink && (
          <a class="inline-flex items-center gap-1.5 text-sm font-extrabold text-slate-100 transition hover:text-accent" href={githubHref}>
            <BrandIcon name="github" size={17} /> GitHub
          </a>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .abstract-thumb {
    position: relative;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 30% 25%, rgba(56, 189, 248, 0.45), transparent 24%),
      radial-gradient(circle at 72% 68%, rgba(37, 99, 235, 0.36), transparent 28%),
      linear-gradient(135deg, #07111f, #0f172a 45%, #020617);
  }

  .abstract-thumb::before,
  .abstract-thumb::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .abstract-platform::before {
    background-image:
      linear-gradient(rgba(96, 165, 250, 0.18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(96, 165, 250, 0.18) 1px, transparent 1px);
    background-size: 36px 36px;
    transform: perspective(600px) rotateX(58deg) scale(1.25);
    transform-origin: center bottom;
  }

  .abstract-platform span {
    position: absolute;
    width: 72px;
    height: 72px;
    border: 1px solid rgba(125, 211, 252, 0.55);
    background: linear-gradient(145deg, rgba(96, 165, 250, 0.82), rgba(14, 165, 233, 0.24));
    box-shadow: 0 18px 42px rgba(37, 99, 235, 0.38);
    transform: rotate(45deg) skew(-8deg, -8deg);
  }

  .abstract-platform span:nth-child(1) {
    left: 32%;
    top: 30%;
  }

  .abstract-platform span:nth-child(2) {
    left: 47%;
    top: 42%;
  }

  .abstract-platform span:nth-child(3) {
    left: 38%;
    top: 55%;
  }

  .abstract-network::before {
    background:
      linear-gradient(25deg, transparent 23%, rgba(125, 211, 252, 0.28) 24%, transparent 25% 57%, rgba(99, 102, 241, 0.32) 58%, transparent 59%),
      linear-gradient(143deg, transparent 28%, rgba(125, 211, 252, 0.26) 29%, transparent 30% 64%, rgba(99, 102, 241, 0.32) 65%, transparent 66%);
  }

  .abstract-network span {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #8b5cf6;
    box-shadow: 0 0 28px rgba(139, 92, 246, 0.9);
  }

  .abstract-network span:nth-child(1) {
    left: 23%;
    top: 48%;
  }

  .abstract-network span:nth-child(2) {
    left: 51%;
    top: 31%;
    background: #38bdf8;
  }

  .abstract-network span:nth-child(3) {
    left: 72%;
    top: 58%;
  }
</style>
