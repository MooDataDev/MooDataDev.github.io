---
interface Props {
  icon: any;
  title: string;
  description: string;
}

const { icon: Icon, title, description } = Astro.props;
---

<article class="glass-card group rounded-xl p-6 transition duration-200 hover:-translate-y-1 hover:border-accent/55">
  <div class="mb-5 grid size-12 place-items-center rounded-xl border border-accent/30 bg-blue-500/10 text-accent">
    <Icon size={26} stroke-width={1.7} aria-hidden="true" />
  </div>
  <h3 class="text-lg font-extrabold text-white">{title}</h3>
  <p class="mt-3 text-sm leading-7 text-slate-300">{description}</p>
</article>
