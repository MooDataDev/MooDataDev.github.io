---
import { CircleCheck } from "@lucide/astro";

const bullets = [
  "Built and operated large-scale production AI services processing 350k+ documents per day.",
  "Enabled 100+ departments with self-service AI capabilities, serving 6,000+ active users.",
  "Designed high-throughput inference pipelines delivering 3.5M+ daily inferences.",
  "Led AI-related workstreams in a €5.7M European initiative with 15+ partners.",
  "Drove engineering excellence, observability, and responsible AI across cross-functional teams."
];

const highlights = ["350k+", "100+", "6,000+", "3.5M+", "€5.7M", "15+"];

function highlightText(text: string) {
  const pattern = new RegExp(`(${highlights.map((item) => item.replace(/[+€]/g, "\\$&")).join("|")})`, "g");
  return text.replace(pattern, '<span class="font-extrabold text-accent">$1</span>');
}
---

<section id="impact" class="section scroll-mt-24">
  <div class="container-shell">
    <slot name="heading" />
    <div class="glass-card rounded-xl p-6 md:p-8">
      <ul class="space-y-4">
        {bullets.map((bullet) => (
          <li class="flex gap-3 text-sm leading-7 text-slate-200 md:text-base">
            <CircleCheck class="mt-1 shrink-0 text-accent" size={20} stroke-width={1.9} aria-hidden="true" />
            <span set:html={highlightText(bullet)} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
