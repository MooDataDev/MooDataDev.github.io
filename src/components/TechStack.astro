---
interface Category {
  title: string;
  icon: any;
  items: string[];
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<section id="stack" class="section scroll-mt-24">
  <div class="container-shell">
    <slot name="heading" />
    <div class="glass-card grid gap-px overflow-hidden rounded-xl md:grid-cols-2 lg:grid-cols-4">
      {categories.map(({ title, icon: Icon, items }) => (
        <article class="bg-slate-950/10 p-6">
          <div class="mb-5 flex items-center gap-3">
            <Icon size={25} class="text-accent" stroke-width={1.8} aria-hidden="true" />
            <h3 class="font-extrabold text-white">{title}</h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {items.map((item) => (
              <span class="rounded-md border border-white/10 bg-white/[0.04] px-2.5 py-1.5 text-xs font-semibold text-slate-300">{item}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
