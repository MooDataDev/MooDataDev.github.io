---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="mb-10 flex items-center justify-center gap-5">
  <span class="h-px w-full max-w-40 bg-gradient-to-r from-transparent to-blue-500/55"></span>
  <h2 class="shrink-0 text-center text-2xl font-extrabold tracking-tight text-white md:text-3xl">{title}</h2>
  <span class="h-px w-full max-w-40 bg-gradient-to-l from-transparent to-blue-500/55"></span>
</div>
