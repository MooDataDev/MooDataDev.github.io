---
import { Download } from "@lucide/astro";
import BrandIcon from "./BrandIcon.astro";
---

<footer id="contact" class="scroll-mt-24 border-t border-white/10 bg-blue-950/20">
  <div class="container-shell py-12 text-center">
    <h2 class="text-3xl font-extrabold tracking-tight text-white md:text-4xl">Let’s build what’s next.</h2>
    <p class="mt-3 text-slate-300">Based in Berlin · Open to AI roles in Singapore</p>
    <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
      <a class="button button-secondary" href="https://www.linkedin.com/in/tobias-weller-b94775138">
        <BrandIcon name="linkedin" /> LinkedIn
      </a>
      <a class="button button-secondary" href="https://github.com/MooDataDev">
        <BrandIcon name="github" /> GitHub
      </a>
      <a class="button button-primary" href="/assets/cv.pdf" download>
        <Download size={18} aria-hidden="true" /> Download CV
      </a>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-shell flex flex-col gap-2 py-5 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 Dr. Tobias Weller</p>
      <p>GitHub Pages. No cookies · No tracking</p>
    </div>
  </div>
</footer>
